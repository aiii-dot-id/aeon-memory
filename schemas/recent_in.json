{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recent input",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Optional project scope."
    },
    "mode": {
      "type": "string",
      "enum": ["mru", "oldest"],
      "default": "mru",
      "description": "mru: most recently used first. oldest: least recently used first, from the tail of the same recency order. Both are pure reads; neither reorders."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10,
      "description": "Maximum notes to return."
    }
  },
  "additionalProperties": false
}
