{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search output",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "description": "Matching alive notes, best score first, newest first on ties.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project": {
            "type": "string"
          },
          "created_ms": {
            "type": "integer"
          },
          "updated_ms": {
            "type": "integer",
            "description": "Present once the note has been revised."
          },
          "evicted": {
            "type": "boolean",
            "description": "True when the note is soft-evicted: readable by id, absent from search, recent and recall."
          },
          "pinned": {
            "type": "boolean",
            "description": "True when the note is exempt from capacity reclaim; eviction is its only exit."
          },
          "score": {
            "type": "integer",
            "description": "Terms found, counted once per field."
          }
        }
      }
    },
    "count": {
      "type": "integer",
      "description": "Notes returned."
    },
    "scanned": {
      "type": "integer",
      "description": "Alive notes examined: the whole store."
    },
    "matched": {
      "type": "integer",
      "description": "Notes that matched before the limit."
    },
    "limit": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean",
      "description": "True when matched exceeds count."
    }
  },
  "required": [
    "results",
    "count",
    "scanned",
    "matched"
  ]
}
