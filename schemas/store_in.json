{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "store input",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "The note to keep."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Tags for keyword search: non-empty strings without '|'."
    },
    "project": {
      "type": "string",
      "description": "Optional project scope."
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Exempt this note from capacity reclaim. A pinned note is never displaced by a new store; eviction is its only exit."
    }
  },
  "required": [
    "content"
  ],
  "additionalProperties": false
}
